{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TraceAnnotate_Asset_Schema_V2",
  "description": "Standard 46-key schema for raw video and image multi-modal annotations with provenance tracking",
  "type": "object",
  "required": [
    "asset_id", "rel_path", "kind", "ext", "size", "head1mb_md5",
    "primary_entity", "entity_status", "tags",
    "brightness", "sharpness", "is_bad_frame",
    "dhash", "similar_cluster_id", "fill"
  ],
  "properties": {
    "asset_id": { "type": "string" },
    "rel_path": { "type": "string" },
    "kind": { "type": "string", "enum": ["image", "video"] },
    "ext": { "type": "string" },
    "size": { "type": "integer" },
    "head1mb_md5": { "type": "string" },
    "full_md5": { "type": ["string", "null"] },
    "width": { "type": "integer" },
    "height": { "type": "integer" },
    "aspect_ratio": { "type": "number" },
    "duration": { "type": ["number", "null"] },
    "fps": { "type": ["number", "null"] },
    "video_codec": { "type": ["string", "null"] },
    "audio_codec": { "type": ["string", "null"] },
    "primary_entity": { "type": "string" },
    "entity_status": { "type": "string", "enum": ["none", "candidate", "confirmed"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "indoor_outdoor": { "type": ["string", "null"] },
    "time_of_day": { "type": ["string", "null"] },
    "weather": { "type": ["string", "null"] },
    "screen_type": { "type": "string" },
    "mood": { "type": ["string", "null"] },
    "face_count": { "type": "integer" },
    "face_status": { "type": "string" },
    "crowd_level": { "type": "string" },
    "face_subject_kind": { "type": "string", "enum": ["none", "real_person", "statue_face", "artifact_face"] },
    "face_review": { "type": "boolean" },
    "ocr_text": { "type": "string" },
    "ocr_readable": { "type": "string" },
    "ocr_clean": { "type": "string" },
    "brightness": { "type": "number" },
    "sharpness": { "type": "number" },
    "is_bad_frame": { "type": "boolean" },
    "dhash": { "type": ["string", "null"] },
    "similar_cluster_id": { "type": "string" },
    "usage_blacklist": { "type": "boolean" },
    "usable_windows": { "type": ["array", "null"] },
    "best_frame_ts": { "type": ["number", "null"] },
    "scene_sub_segments": { "type": ["array", "null"] },
    "tech_quality": { "type": "object" },
    "clip_scores": { "type": "object" },
    "source_type": { "type": "string" },
    "import_date": { "type": ["string", "null"] },
    "fill": {
      "type": "object",
      "description": "Field-level provenance mapping: field_name -> source_tier"
    }
  }
}
